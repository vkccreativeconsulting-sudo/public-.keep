# ---------------------------------------------------------------------------
# VICE CITY AIRWATCH — environment configuration
# Copy to .env.local for development. All values have sensible defaults.
# ---------------------------------------------------------------------------

# Aircraft data provider used by /api/blimp.
#   airplaneslive  — https://airplanes.live/api-guide/  (no key, 1 req/s per IP)
#   adsblol        — https://api.adsb.lol/docs           (no key, keep ≤ 1 req/s)
#   demo           — synthetic positions, clearly labeled DEMO (never real tracking)
AIRCRAFT_PROVIDER=airplaneslive
# Secondary provider tried when the primary fails (set to "none" to disable).
AIRCRAFT_FALLBACK_PROVIDER=adsblol

# Which aircraft to follow. Defaults are Goodyear "Wingfoot Three".
AIRCRAFT_REGISTRATION=N3A
AIRCRAFT_ICAO_HEX=A31AA0
AIRCRAFT_NAME=Wingfoot Three

# Optional: if your provider plan issues an API key, it is sent as a request
# header on every upstream call. The public endpoints above need none.
AIRCRAFT_API_KEY=
AIRCRAFT_API_KEY_HEADER=auth

# Override provider base URLs (e.g. a self-hosted readsb / tar1090 instance).
AIRPLANES_LIVE_BASE_URL=https://api.airplanes.live/v2
ADSB_LOL_BASE_URL=https://api.adsb.lol/v2

# Server-side cache window. Upstream is called at most once per window no
# matter how many visitors are connected. Keep ≥ 10000 to respect rate limits.
UPSTREAM_CACHE_MS=15000
# Observations younger than this are LIVE; older ones are LAST SEEN.
LIVE_MAX_AGE_SECONDS=120
UPSTREAM_TIMEOUT_MS=8000
# Maximum verified positions kept in the server-side trail.
TRAIL_MAX_POINTS=720
# Allow ?demo=1 on the API in production builds (default: dev only).
ALLOW_DEMO_QUERY=false

# ---- Client (public) ------------------------------------------------------
# How often the browser polls /api/blimp.
NEXT_PUBLIC_POLL_INTERVAL_MS=15000
# OpenMapTiles-schema vector tiles. Default is OpenFreeMap (free, no key).
# MapTiler example: https://api.maptiler.com/tiles/v3/tiles.json?key=YOUR_KEY
NEXT_PUBLIC_TILE_JSON_URL=https://tiles.openfreemap.org/planet
NEXT_PUBLIC_GLYPHS_URL=https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf
# Attribution HTML shown in the HUD (must credit your tile provider).
# NEXT_PUBLIC_TILE_ATTRIBUTION=
